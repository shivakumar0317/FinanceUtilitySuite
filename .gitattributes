# Finance Utility Suite line-ending policy
# Keep source and configuration files consistent across Windows and Linux/Docker.
* text=auto

*.py       text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf

*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.xlsx     binary
*.xls      binary
